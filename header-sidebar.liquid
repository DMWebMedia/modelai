{%- comment -%}HEADER SIDEBAR COMPONENT{%- endcomment -%}

<template id="header-sidebar-template">
  <div part="base">
    <div part="overlay"></div>
    <div part="content">
      <header part="header">
        <dialog-close-button class="contents">
          <button type="button" part="close-button tap-area" aria-label="{{ 'general.accessibility.close' | t | escape }}">
            {%- render 'icon' with 'close', width: 16 -%}
          </button>
        </dialog-close-button>
      </header>
      <div part="panel-list">
        <slot name="main-panel"></slot>
      </div>
    </div>
  </div>
</template>

<style>
  .mds-item {
    border-bottom: 1px solid rgba(0,0,0,0.07);
  }
  .mds-item summary, .mds-item-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 15px 0;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 400;
    color: inherit;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    list-style: none;
  }
  .mds-item summary::-webkit-details-marker { display: none; }
  .mds-plus {
    font-size: 18px;
    font-weight: 200;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.25s ease;
    display: inline-block;
  }
  details[open] > summary .mds-plus {
    transform: rotate(45deg);
  }
  .mds-sub {
    padding: 0 0 8px 0;
  }
  .mds-sub-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0 10px 14px;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    opacity: 0.65;
    list-style: none;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
  }
  .mds-sub-link:hover { opacity: 1; }
  .mds-sub-plus {
    font-size: 15px;
    font-weight: 200;
    flex-shrink: 0;
    transition: transform 0.25s ease;
    display: inline-block;
  }
  details[open] > summary .mds-sub-plus {
    transform: rotate(45deg);
  }
  .mds-sub-sub {
    padding: 0 0 6px 28px;
  }
  .mds-sub-sub a {
    display: block;
    padding: 8px 0;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    opacity: 0.5;
  }
  .mds-sub-sub a:hover { opacity: 0.9; }
  .mds-help-link {
    display: block;
    padding: 11px 0;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    opacity: 0.6;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .mds-help-link:last-of-type { border-bottom: none; }
  .mds-help-link:hover { opacity: 1; }
  .mds-socials-wrap {
    border-top: 1px solid rgba(128,128,128,0.2);
    margin-top: 28px;
    padding-top: 20px;
    padding-bottom: 16px;
  }
  .mds-socials-wrap .social-media {
    justify-content: center !important;
    gap: 24px !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .mds-socials-wrap .social-media__item a {
    opacity: 0.5;
    color: inherit;
    display: flex;
    align-items: center;
  }
  .mds-socials-wrap .social-media__item a:hover {
    opacity: 1;
  }
  .mds-socials-wrap .social-media__item svg {
    width: 17px;
    height: 17px;
  }
</style>

<header-sidebar id="sidebar-menu" class="header-sidebar drawer drawer--sm color-scheme color-scheme--{{ color_scheme.id }}" template="header-sidebar-template" open-from="left">
  <div class="header-sidebar__main-panel" slot="main-panel">
    <div class="header-sidebar__scroller" style="display:flex;flex-direction:column;min-height:100%;">

      <div style="flex:1;">

        <!-- MAIN MENU -->
        <ul class="unstyled-list" style="margin:0;padding:0;" role="list">
          {%- for link in menu.links -%}
            <li class="mds-item">
              {%- if link.links.size > 0 -%}
                <accordion-disclosure>
                  <details class="accordion__disclosure">
                    <summary>
                      <span>{{ link.title }}</span>
                      <span class="mds-plus">+</span>
                    </summary>
                    <div class="mds-sub">
                      {%- assign parent_title_down = link.title | downcase | strip -%}
                      {%- assign skip_parents = 'new in,men,sportswear' | split: ',' -%}
                      {%- for sub_link in link.links -%}
                        {%- assign sub_title_down = sub_link.title | downcase | strip -%}
                        {%- if skip_parents contains parent_title_down and sub_title_down == parent_title_down -%}
                          {%- continue -%}
                        {%- endif -%}
                        {%- if sub_link.links.size > 0 -%}
                          <accordion-disclosure>
                            <details class="accordion__disclosure">
                              <summary class="mds-sub-link">
                                <span>{{ sub_link.title }}</span>
                                <span class="mds-sub-plus">+</span>
                              </summary>
                              <div class="mds-sub-sub">
                                {%- for sub_sub_link in sub_link.links -%}
                                  <a href="{{ sub_sub_link.url }}">{{ sub_sub_link.title }}</a>
                                {%- endfor -%}
                              </div>
                            </details>
                          </accordion-disclosure>
                        {%- else -%}
                          <a href="{{ sub_link.url }}" class="mds-sub-link" style="text-decoration:none;">
                            <span>{{ sub_link.title }}</span>
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
                </accordion-disclosure>
              {%- else -%}
                <a href="{{ link.url }}" class="mds-item-link">
                  <span>{{ link.title }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <!-- HELP LINKS -->
        <div style="margin-top:28px;">
          <a href="/apps/17TRACK" class="mds-help-link">Track My Order</a>
          <a href="/pages/shipping-rates" class="mds-help-link">Shipping</a>
          {%- if localization.country.iso_code == 'LB' -%}
            <a href="/pages/returns-exchanges-policy" class="mds-help-link">Exchange Policy</a>
          {%- else -%}
            <a href="/pages/returns-exchanges-policy" class="mds-help-link">Returns &amp; Exchange Policy</a>
          {%- endif -%}
          <a href="/pages/contact-us" class="mds-help-link">Help &amp; Contact</a>
        </div>

      </div>

      <!-- SOCIALS AT BOTTOM -->
      <div class="mds-socials-wrap">
        {%- render 'social-media', layout: 'list' -%}
      </div>

    </div>

    {%- liquid
      if section.settings.show_country_selector and localization.available_countries.size > 1
        assign show_country_selector = true
      endif
      if section.settings.show_locale_selector and localization.available_languages.size > 1
        assign show_locale_selector = true
      endif
    -%}

    {%- if show_country_selector or show_locale_selector -%}
      <div class="header-sidebar__footer">
        <div class="localization-selectors">
          {%- if show_country_selector -%}
            {%- render 'localization-selector', type: 'country', placement: 'top-start', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, id_prefix: 'header-sidebar' -%}
          {%- endif -%}
          {%- if show_country_selector and show_locale_selector -%}
            <span class="localization-selectors__separator" aria-hidden="true"></span>
          {%- endif -%}
          {%- if show_locale_selector -%}
            {%- render 'localization-selector', type: 'locale', placement: 'top-start', id_prefix: 'header-sidebar' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</header-sidebar>
